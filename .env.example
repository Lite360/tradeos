# TradeOS Environment Configuration
# Copy this file to .env.local and populate with your credentials

# Supabase Auth & Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Neon Serverless PostgreSQL / Backend API
VITE_API_BASE_URL=https://tradeos.ng/api

# Paystack Payment Gateway Integration (Public Key)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Environment
VITE_APP_ENV=production
VITE_APP_NAME=TradeOS
VITE_APP_CURRENCY=NGN
